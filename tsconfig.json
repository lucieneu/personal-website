{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  // Build output and Playwright's reports (generated, and ignored by git) aren't type-checked.
  "exclude": ["dist", "test-results", "playwright-report"],
  "compilerOptions": {
    // Absolute imports from src/ (`@/i18n/utils`), read by TypeScript, Astro/Vite and Playwright.
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
