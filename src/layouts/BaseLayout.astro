---
import { Font } from 'astro:assets';
import ContentCard from '../components/ContentCard.astro';
import Sidebar from '../components/Sidebar.astro';
import { getLang, useTranslations } from '../i18n/utils';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  /** Page title; the site name is appended. Leave out on the home page. */
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const pageTitle = title ? `${title} · ${t('site.name')}` : t('site.name');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* Only the sans font is preloaded: it's used above the fold on every page. */}
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-jetbrains-mono" />
  </head>
  <body>
    <div class="layout">
      <Sidebar lang={lang} />
      <ContentCard>
        <slot />
      </ContentCard>
    </div>
  </body>
</html>

<style>
  @media (min-width: 1024px) {
    /* 11fr : 18fr is the 440 : 720 ratio of the two max widths, so on narrower screens both
       columns shrink together and reach their max widths at the same time. */
    .layout {
      display: grid;
      grid-template-columns: minmax(0, 11fr) minmax(0, 18fr);
      align-items: start;
      column-gap: var(--space-16);
      max-width: calc(
        var(--sidebar-max-width) + var(--card-max-width) + var(--space-16) + 2 * var(--space-12)
      );
      margin-inline: auto;
      padding-inline: var(--space-12);
    }
  }
</style>
