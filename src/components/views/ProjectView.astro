---
// One project in either language: cover, the body (problem, approach, result), stack and links.
import { render } from 'astro:content';
import { getLang, localePath, useTranslations } from '../../i18n/utils';
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { Project } from '../../lib/projects';
import CoverImage from '../atoms/CoverImage.astro';
import DateTime from '../atoms/DateTime.astro';
import Link from '../atoms/Link.astro';
import List from '../atoms/List.astro';
import Tags from '../molecules/Tags.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, summary, date, role, stack, cover, coverAlt, links } = project.data;
const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const { Content } = await render(project);
---

<BaseLayout title={title} description={summary} ogType="article">
  <p class="back">
    <Link href={localePath(lang, 'projects')} arrow="back">
      {t('project.back')}
    </Link>
  </p>

  <h1>{title}</h1>
  <p class="summary">{summary}</p>

  <dl class="meta">
    <div>
      <dt>{t('project.date')}</dt>
      <dd>
        <DateTime date={date} lang={lang} />
      </dd>
    </div>
    <div>
      <dt>{t('project.role')}</dt>
      <dd>{role}</dd>
    </div>
  </dl>

  {/* Above the fold, so it loads right away (it's often the largest element on the page). */}
  <CoverImage
    src={cover}
    alt={coverAlt}
    widths={[640, 1280]}
    sizes="(min-width: 1024px) 640px, calc(100vw - 82px)"
    loading="eager"
  />

  <div class="body">
    <Content />
  </div>

  <h2>{t('project.stack')}</h2>
  <Tags items={stack} />

  {(links.live || links.repo) && (
    <List inline class="links">
      {links.live && (
        <li>
          <Link href={links.live}>{t('project.live')}</Link>
        </li>
      )}
      {links.repo && (
        <li>
          <Link href={links.repo}>{t('project.repo')}</Link>
        </li>
      )}
    </List>
  )}
</BaseLayout>

<style>
  .back {
    margin-bottom: var(--space-6);
    font-size: var(--font-size-small);
  }

  .summary {
    color: var(--color-text-muted);
    font-size: var(--font-size-h3);
    line-height: var(--line-height-heading);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-8);
    margin: var(--space-6) 0;
    font-size: var(--font-size-small);
  }

  dt {
    color: var(--color-text-muted);
  }

  dd {
    margin: 0;
  }

  .body {
    margin-top: var(--space-8);
  }

  .links {
    gap: var(--space-2) var(--space-6);
    margin-top: var(--space-8);
  }
</style>
