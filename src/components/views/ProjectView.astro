---
// One project in either language: cover, the body (problem, approach, result), stack and links.
import { render } from 'astro:content';
import { localePath, pageLang } from '../../i18n/utils';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projectLinks, type Project } from '../../lib/projects';
import CoverImage from '../atoms/CoverImage.astro';
import DateTime from '../atoms/DateTime.astro';
import Link from '../atoms/Link.astro';
import List from '../atoms/List.astro';
import LinkItem from '../molecules/LinkItem.astro';
import MetaItem from '../molecules/MetaItem.astro';
import MetaList from '../molecules/MetaList.astro';
import Tags from '../molecules/Tags.astro';
import styles from './ProjectView.module.css';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { title, summary, date, role, stack, cover, coverAlt } = project.data;
const { lang, t } = pageLang(Astro.currentLocale);
const { Content } = await render(project);
const links = projectLinks(project, lang);
---

<BaseLayout title={title} description={summary} ogType="article">
  <p class={styles.back}>
    <Link href={localePath(lang, 'projects')} arrow="back">
      {t('project.back')}
    </Link>
  </p>

  <h1>{title}</h1>
  <p class={styles.summary}>{summary}</p>

  <MetaList class={styles.meta}>
    <MetaItem label={t('project.date')}>
      <DateTime date={date} />
    </MetaItem>
    <MetaItem label={t('project.role')}>{role}</MetaItem>
  </MetaList>

  {/* Above the fold, so it loads right away (it's often the largest element on the page). */}
  <CoverImage
    src={cover}
    alt={coverAlt}
    widths={[640, 1280]}
    sizes="(min-width: 64em) 640px, calc(100vw - 82px)"
    loading="eager"
  />

  <div class={styles.body}>
    <Content />
  </div>

  <h2>{t('project.stack')}</h2>
  <Tags items={stack} />

  {links.length > 0 && (
    <List inline class={styles.links}>
      {links.map(({ href, label }) => (
        <LinkItem href={href}>{label}</LinkItem>
      ))}
    </List>
  )}
</BaseLayout>
