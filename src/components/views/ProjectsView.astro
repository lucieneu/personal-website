---
// The list of all projects in either language. The page file may pass an intro.
import { getLang, useTranslations } from '../../i18n/utils';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects } from '../../lib/projects';
import List from '../atoms/List.astro';
import ProjectCard from '../molecules/ProjectCard.astro';

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const projects = await getProjects(lang);
---

<BaseLayout title={t('projects.title')} description={t('projects.description')}>
  <h1>{t('projects.title')}</h1>
  <slot />
  <List class="projects">
    {projects.map((project) => (
      <li>
        <ProjectCard project={project} lang={lang} headingLevel="h2" />
      </li>
    ))}
  </List>
</BaseLayout>

<style>
  .projects {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }
</style>
