---
// The home page in either language. The page file passes the intro (with its <h1>).
import { localePath, pageLang } from '../../i18n/utils';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getFeaturedProjects } from '../../lib/projects';
import Link from '../atoms/Link.astro';
import ProjectList from '../organisms/ProjectList.astro';
import styles from './HomeView.module.css';

const { lang, t } = pageLang(Astro.currentLocale);
const projects = await getFeaturedProjects(lang);
---

<BaseLayout description={t('site.description')}>
  <slot />

  <section aria-labelledby="featured">
    <h2 id="featured">{t('home.featured')}</h2>
    <ProjectList projects={projects} headingLevel="h3" />
    <p class={styles.more}>
      <Link href={localePath(lang, 'projects')} arrow="forward">
        {t('home.allProjects')}
      </Link>
    </p>
  </section>
</BaseLayout>
