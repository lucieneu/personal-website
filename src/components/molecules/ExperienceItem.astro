---
// One job in the ExperienceTimeline: the period, role and employer, a summary and the stack.
import type { CollectionEntry } from 'astro:content';
import type { Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import DateTime from '../atoms/DateTime.astro';
import styles from './ExperienceItem.module.css';
import Tags from './Tags.astro';

interface Props {
  job: CollectionEntry<'experience'>;
  lang: Lang;
}

const { job, lang } = Astro.props;
const { company, role, start, end, summary, stack } = job.data;
const t = useTranslations(lang);
---

<li class={styles.item}>
  <p class={styles.period}>
    <DateTime date={start} lang={lang} precision="month" /> –{' '}
    {end ? <DateTime date={end} lang={lang} precision="month" /> : t('about.present')}
  </p>
  <h3 class={styles.heading}>
    {role[lang]} · {company}
  </h3>
  <p>{summary[lang]}</p>
  <Tags items={stack} label={t('project.stack')} />
</li>
