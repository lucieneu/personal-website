---
// One job in the ExperienceTimeline: the period, role and employer, a summary and the stack.
import type { Job } from '../../lib/experience';
import { pageLang } from '../../i18n/utils';
import DateTime from '../atoms/DateTime.astro';
import styles from './ExperienceItem.module.css';
import Tags from './Tags.astro';

interface Props {
  job: Job;
}

const { job } = Astro.props;
const { company, role, start, end, summary, stack } = job.data;
const { lang, t } = pageLang(Astro.currentLocale);
---

<li class={styles.item}>
  <p class={styles.period}>
    <DateTime date={start} precision="month" /> –{' '}
    {end ? <DateTime date={end} precision="month" /> : t('about.present')}
  </p>
  <h3 class={styles.heading}>
    {role[lang]} · {company}
  </h3>
  <p>{summary[lang]}</p>
  <Tags items={stack} label={t('project.stack')} />
</li>
