---
// Short facts side by side, such as a project's date and role. Fill it with MetaItems.
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'dl'>;

const { class: className, ...rest } = Astro.props;
---

<dl class:list={['meta-list', className]} {...rest}>
  <slot />
</dl>

<style>
  .meta-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-8);
    font-size: var(--font-size-small);
  }
</style>
