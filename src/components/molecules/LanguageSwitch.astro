---
// NL / EN: links to the same page in the other language.
import type { Lang } from '../../i18n/ui';
import { langs, useTranslations } from '../../i18n/utils';
import List from '../atoms/List.astro';
import LanguageOption from './LanguageOption.astro';
import styles from './LanguageSwitch.module.css';

interface Props {
  lang: Lang;
  /** Where each language's link goes: the same page in that language. */
  targets: Record<Lang, string>;
}

const { lang, targets } = Astro.props;
const t = useTranslations(lang);
---

<nav aria-label={t('lang.label')}>
  <List class={styles.languages}>
    {langs.map((code) => (
      <LanguageOption code={code} href={targets[code]} current={code === lang} />
    ))}
  </List>
</nav>
