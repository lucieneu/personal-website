---
// The main navigation. Desktop: a list in the sidebar. Mobile: an island fixed to the bottom
// of the screen.
import List from '@/components/atoms/List.astro';
import NavItem from '@/components/molecules/NavItem.astro';
import { pageLang } from '@/i18n/utils';
import { navItems } from '@/lib/navigation';
import type { HTMLAttributes } from 'astro/types';
import styles from './MainNav.module.css';

type Props = HTMLAttributes<'nav'>;

const { class: className, ...rest } = Astro.props;
const { lang, t } = pageLang(Astro.currentLocale);

const items = navItems(lang, Astro.url.pathname);
---

<nav class:list={[styles.mainNav, className]} aria-label={t('nav.label')} {...rest}>
  <List class={styles.items}>
    {items.map(({ key, href, current }) => (
      <NavItem href={href} label={t(key)} current={current} />
    ))}
  </List>
</nav>
