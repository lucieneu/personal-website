---
// Links to my profiles elsewhere, side by side. The profiles are listed in src/lib/site.ts.
import type { HTMLAttributes } from 'astro/types';
import type { Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { socialLinks } from '../../lib/site';
import List from '../atoms/List.astro';
import LinkItem from './LinkItem.astro';
import styles from './SocialLinks.module.css';

interface Props extends HTMLAttributes<'ul'> {
  lang: Lang;
}

const { lang, class: className, ...rest } = Astro.props;
const t = useTranslations(lang);
---

<List inline class:list={[styles.socialLinks, className]} aria-label={t('social.label')} {...rest}>
  {socialLinks.map(({ label, href }) => (
    <LinkItem href={href} tone="muted">
      {label}
    </LinkItem>
  ))}
</List>
