---
// A link as an item in a list, such as a profile in SocialLinks or a project's links. Takes the
// same props as Link.
import Link from '@/components/atoms/Link.astro';
import type { ComponentProps } from 'astro/types';

type Props = ComponentProps<typeof Link>;
---

<li>
  <Link {...Astro.props}>
    <slot />
  </Link>
</li>
