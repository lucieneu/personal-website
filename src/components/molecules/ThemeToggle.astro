---
import type { Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

interface Props {
  lang: Lang;
}

const t = useTranslations(Astro.props.lang);
---

{/* aria-pressed is set by the script below, once it knows the current theme. */}
<button type="button" class="theme-toggle" data-theme-toggle>
  <svg class="icon icon-moon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"></path>
  </svg>
  <svg class="icon icon-sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
  <span class="visually-hidden">{t('theme.dark')}</span>
</button>

<script>
  import { currentTheme, toggleTheme } from '../../lib/theme';

  const syncPressed = () => {
    const pressed = String(currentTheme() === 'dark');
    for (const button of document.querySelectorAll('[data-theme-toggle]')) {
      button.setAttribute('aria-pressed', pressed);
    }
  };

  // The sidebar is replaced on every navigation, so the new button needs its listener again.
  document.addEventListener('astro:page-load', () => {
    syncPressed();
    document
      .querySelector<HTMLButtonElement>('[data-theme-toggle]')
      ?.addEventListener('click', toggleTheme);
  });
  document.addEventListener('theme-change', syncPressed);
  matchMedia('(prefers-color-scheme: dark)').addEventListener('change', syncPressed);
</script>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: var(--size-control);
    height: var(--size-control);
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-text-muted);
    cursor: pointer;
    transition:
      color var(--duration-hover) ease-out,
      border-color var(--duration-hover) ease-out;
  }

  .theme-toggle:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .icon {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* The icon shows the theme a click switches to: a moon in light mode, a sun in dark mode. */
  .icon-sun {
    display: none;
  }

  :global(:root[data-theme='dark']) .icon-sun {
    display: block;
  }

  :global(:root[data-theme='dark']) .icon-moon {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .icon-sun {
      display: block;
    }

    :global(:root:not([data-theme='light'])) .icon-moon {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle {
      transition: none;
    }
  }
</style>
