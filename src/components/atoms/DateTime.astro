---
// A date written out for the page's language ("oktober 2026"), in a <time> element.
import type { Lang } from '../../i18n/ui';
import { formatDate } from '../../i18n/utils';

interface Props {
  date: Date;
  lang: Lang;
  /** How precise the machine-readable date is: a day (2026-10-18) or only a month (2026-10). */
  precision?: 'day' | 'month';
}

const { date, lang, precision = 'day' } = Astro.props;
const datetime = date.toISOString().slice(0, precision === 'day' ? 10 : 7);
---

<time datetime={datetime}>{formatDate(date, lang)}</time>
