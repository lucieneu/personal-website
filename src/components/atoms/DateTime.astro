---
// A date written out for the page's language ("oktober 2026"), in a <time> element.
import type { Lang } from '../../i18n/ui';
import { formatDate, isoDate } from '../../lib/date';

interface Props {
  date: Date;
  lang: Lang;
  /** How precise the machine-readable date is: a day (2026-10-18) or only a month (2026-10). */
  precision?: 'day' | 'month';
}

const { date, lang, precision } = Astro.props;
---

<time datetime={isoDate(date, precision)}>{formatDate(date, lang)}</time>
