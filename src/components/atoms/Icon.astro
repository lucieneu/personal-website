---
// A 20px line icon in the current text color. Decorative: the control it's in carries the name.
import type { HTMLAttributes } from 'astro/types';
import styles from './Icon.module.css';

interface Props extends HTMLAttributes<'svg'> {
  name: 'moon' | 'sun';
}

const { name, class: className, ...rest } = Astro.props;
---

<svg class:list={[styles.icon, className]} viewBox="0 0 24 24" aria-hidden="true" {...rest}>
  {name === 'moon' && <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />}
  {name === 'sun' && (
    <>
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
    </>
  )}
</svg>
