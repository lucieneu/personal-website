---
// Text that's hidden on screen but still read by screen readers, such as the name of an
// icon-only button.
---

<span class="visually-hidden">
  <slot />
</span>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
