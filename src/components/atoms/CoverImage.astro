---
// A project's cover image: AVIF with a WebP fallback, full width with rounded corners.
import { loadingAttributes, type ImageLoading } from '@/lib/images';
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import styles from './CoverImage.module.css';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** The widths to generate, matching how wide `sizes` says the image is shown. */
  widths: number[];
  sizes: string;
  /**
   * lazy (default) for images further down the page. eager for a cover above the fold, which
   * is often the largest element on the page.
   */
  loading?: ImageLoading;
  class?: string;
}

const { loading = 'lazy', class: className, ...rest } = Astro.props;
---

<Picture
  class:list={[styles.coverImage, className]}
  formats={['avif']}
  fallbackFormat="webp"
  {...rest}
  {...loadingAttributes(loading)}
/>
