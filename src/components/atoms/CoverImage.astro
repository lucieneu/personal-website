---
// A project's cover image: AVIF with a WebP fallback, full width with rounded corners.
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** The widths to generate, matching how wide `sizes` says the image is shown. */
  widths: number[];
  sizes: string;
  /**
   * lazy (default) for images further down the page. eager for a cover above the fold, which
   * is often the largest element on the page; it also gets fetchpriority="high".
   */
  loading?: 'lazy' | 'eager';
  class?: string;
}

const { loading = 'lazy', class: className, ...rest } = Astro.props;
// Lazy is Picture's default, so only eager needs attributes.
const priority = loading === 'eager' ? ({ loading: 'eager', fetchpriority: 'high' } as const) : {};
---

<Picture
  class:list={['cover-image', className]}
  formats={['avif']}
  fallbackFormat="webp"
  {...rest}
  {...priority}
/>

<style>
  .cover-image {
    width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
  }
</style>
