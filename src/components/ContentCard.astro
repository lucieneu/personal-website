---
// The card is split into a frame (<main>) and a body, so phase 1 can give each its own
// view transition: the frame morphs, the body crossfades.
---

<main id="content" class="card">
  <div class="card-body">
    <slot />
  </div>
</main>

<style>
  .card {
    min-width: 0;
    margin: 0 var(--space-4) var(--space-4);
    padding: var(--card-padding-mobile);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }

  .card-body > :global(:first-child) {
    margin-top: 0;
  }

  .card-body > :global(:last-child) {
    margin-bottom: 0;
  }

  @media (min-width: 1024px) {
    .card {
      margin: var(--space-16) 0;
      padding: var(--card-padding);
    }
  }
</style>
