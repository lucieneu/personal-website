---
import Link from '@/components/atoms/Link.astro';
import SecondaryNav from '@/components/molecules/SecondaryNav.astro';
import SocialLinks from '@/components/molecules/SocialLinks.astro';
import { pageLang } from '@/i18n/utils';
import { copyrightNotice, repoUrl } from '@/lib/site';
import styles from './SiteFooter.module.css';

interface Props {
  /**
   * Where this copy sits: at the bottom of the sidebar (desktop) or below the card (mobile).
   * Only one is shown at a time, so the order of the page matches what you see on both.
   */
  placement: 'sidebar' | 'page';
}

const { placement } = Astro.props;
const { t } = pageLang(Astro.currentLocale);
---

<footer
  class:list={[
    styles.footer,
    placement === 'sidebar' ? styles.placementSidebar : styles.placementPage,
  ]}
>
  {/* On desktop the secondary links are in the sidebar, below the main navigation. */}
  {placement === 'page' && <SecondaryNav class={styles.secondaryNav} />}
  <SocialLinks class={styles.social} />
  <p class={styles.copyright}>
    {copyrightNotice(t('site.name'))} ·{' '}
    <Link href={repoUrl} tone="muted">
      {t('footer.source')}
    </Link>
  </p>
</footer>
