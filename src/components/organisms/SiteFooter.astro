---
import type { Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { repoUrl, socialLinks } from '../../lib/site';

interface Props {
  lang: Lang;
  /**
   * Where this copy sits: at the bottom of the sidebar (desktop) or below the card (mobile).
   * Only one is shown at a time, so the order of the page matches what you see on both.
   */
  placement: 'sidebar' | 'page';
}

const { lang, placement } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="footer" data-placement={placement}>
  <ul class="social" aria-label={t('social.label')}>
    {socialLinks.map(({ label, href }) => (
      <li>
        <a href={href}>{label}</a>
      </li>
    ))}
  </ul>
  <p>
    {`© ${year} ${t('site.name')}`} · <a href={repoUrl}>{t('footer.source')}</a>
  </p>
</footer>

<style>
  .footer {
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
  }

  .social {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin: 0 0 var(--space-2);
    padding: 0;
    list-style: none;
  }

  p {
    margin: 0;
  }

  a {
    color: inherit;
  }

  a:hover {
    color: var(--color-accent);
  }

  [data-placement='sidebar'] {
    display: none;
    margin-top: var(--space-6);
  }

  /* Below the card it follows the card's bottom edge while the card morphs, and leaves room
     for the nav island, so the island never covers it. */
  [data-placement='page'] {
    padding: var(--space-6) var(--space-4)
      calc(var(--size-touch) + var(--space-16) + env(safe-area-inset-bottom));
    view-transition-name: site-footer;
  }

  @media (min-width: 1024px) {
    [data-placement='sidebar'] {
      display: block;
    }

    [data-placement='page'] {
      display: none;
    }
  }
</style>
