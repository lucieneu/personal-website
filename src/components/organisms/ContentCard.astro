---
// The card is split into a frame (<main>) and a body, each with its own view transition: the
// frame morphs to the new height, while the body (captured separately, so the text never
// stretches) crossfades. Timing is in src/lib/transitions.ts and src/styles/transitions.css.
import { contentFade } from '../../lib/transitions';
---

{/* tabindex="-1": the skip link and client-side navigations move focus here. */}
<main
  id="content"
  class="card"
  tabindex="-1"
  transition:name="content-card"
  transition:animate="initial"
>
  <div class="card-body" transition:name="content-body" transition:animate={contentFade}>
    <slot />
  </div>
</main>

<style>
  .card {
    min-width: 0;
    margin: 0 var(--space-4);
    padding: var(--card-padding-mobile);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }

  /* Focus lands here after a navigation; the card isn't a control, so it gets no outline. */
  .card:focus {
    outline: none;
  }

  .card-body > :global(:first-child) {
    margin-top: 0;
  }

  .card-body > :global(:last-child) {
    margin-bottom: 0;
  }

  @media (min-width: 1024px) {
    .card {
      margin: var(--space-16) 0 0;
      padding: var(--card-padding);
    }
  }
</style>
