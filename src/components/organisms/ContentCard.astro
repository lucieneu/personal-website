---
// The card is handed off on every navigation: the old one falls away and the new one drops in
// (src/styles/transitions.css; its view transition name alternates, see src/lib/transitions.ts).
// Its content is part of its snapshot, so the text moves with the card and is readable from the
// start.
import styles from './ContentCard.module.css';
---

{/* tabindex="-1": the skip link and client-side navigations move focus here. */}
<main id="content" class={styles.card} tabindex="-1">
  <div class={styles.body}>
    <slot />
  </div>
</main>
