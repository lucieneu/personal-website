---
// Work experience as a timeline, in the order given (getExperience(): newest first). Each job
// is an ExperienceItem.
import List from '@/components/atoms/List.astro';
import ExperienceItem from '@/components/molecules/ExperienceItem.astro';
import type { Job } from '@/lib/experience';

interface Props {
  jobs: Job[];
}

const { jobs } = Astro.props;
---

<List as="ol">
  {jobs.map((job) => (
    <ExperienceItem job={job} />
  ))}
</List>
