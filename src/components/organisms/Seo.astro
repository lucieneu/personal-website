---
// Everything in <head> that search engines and link previews read: title, description,
// canonical URL, the language alternates, Open Graph / Twitter meta and, on the home pages,
// JSON-LD about me.
import { ogLocales, type Lang } from '../../i18n/ui';
import { otherLangs, pageLang } from '../../i18n/utils';
import { absoluteUrl, alternateLinks, canonicalUrl, personJsonLd } from '../../lib/seo';

interface Props {
  /** The full page title, site name included. */
  title: string;
  description: string;
  /** The path of this page in each language. Leave out on pages that have no translation (404). */
  alternates?: Record<Lang, string>;
  noindex?: boolean;
  ogType?: 'website' | 'article';
  /** Adds JSON-LD of type Person (the home pages). */
  person?: boolean;
}

const {
  title,
  description,
  alternates,
  noindex = false,
  ogType = 'website',
  person = false,
} = Astro.props;
const { lang, t } = pageLang(Astro.currentLocale);

// `site` is set in astro.config.mjs; every URL here is absolute, as crawlers expect.
const canonical = canonicalUrl(alternates, lang, Astro.site);
const ogImage = absoluteUrl('/og-default.png', Astro.site);
---

<title>{title}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex" />}
{canonical && <link rel="canonical" href={canonical} />}
{alternateLinks(alternates, Astro.site).map(({ hreflang, href }) => (
  <link rel="alternate" hreflang={hreflang} href={href} />
))}

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={t('site.name')} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{canonical && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={t('site.name')} />
<meta property="og:locale" content={ogLocales[lang]} />
{otherLangs(lang).map((code) => (
  <meta property="og:locale:alternate" content={ogLocales[code]} />
))}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{person && <script is:inline type="application/ld+json" set:html={personJsonLd(lang, canonical)} />}
